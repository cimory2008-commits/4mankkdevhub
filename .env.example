# Isi semua ini di Vercel -> Project -> Settings -> Environment Variables (JANGAN commit file .env asli)

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # Settings -> API -> service_role (RAHASIA)

# --- Admin dashboard ---
ADMIN_PASSWORD=pwaman00aa                   # Sangat disarankan diganti dengan yang lebih panjang & acak

# --- Plugin ---
PLUGIN_SIGN_SECRET=isi-string-acak-panjang  # HARUS sama persis dengan CONFIG.SIGN_SECRET di plugin Luau

# --- Discord (Webhook biasa, hanya untuk notifikasi order) ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789/xxxxxxxx   # Channel Settings -> Integrations -> Webhooks
SITE_URL=https://domain-kamu.vercel.app                                    # untuk link ke panel admin di pesan Discord
